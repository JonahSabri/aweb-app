{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aweb-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ac789edb-777e-4120-8ee2-f7660665ba0c","database_name": "web-appa" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e7fc40e0668a432bab27eb6e9ac59240" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
